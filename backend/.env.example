PORT=4000
DATABASE_URL=postgresql://mekano:mekano@localhost:5432/mekano
JWT_SECRET=change-me-in-production-mekano-secret
CORS_ORIGIN=*

# Validation admin : les liens Valider/Refuser sont envoyés à cet email
ADMIN_EMAIL=nantenainaraherimalala@gmail.com
# URL publique de l'API (utilisée dans les liens de validation des emails)
PUBLIC_URL=http://localhost:4000

# SMTP pour l'envoi des emails (ex. Gmail : smtp.gmail.com + mot de passe d'application)
# Si laissé vide, les liens de validation s'affichent dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Site super admin (https://<api>/admin) : identifiants de connexion.
# Laisser vide désactive la connexion super admin.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── Paiement mobile money des offres ───────────────────────────────────────
# Chaque opérateur apparaît dans l'app dès que ses identifiants sont remplis.
# Les notifications (callbacks) arrivent sur PUBLIC_URL/api/payments/callback/…
# → PUBLIC_URL doit être joignable depuis Internet (https en production).
#
# Mode démo : opérateur « Simulation » qui valide le paiement après 5 s.
PAYMENT_SIMULATION=0
PAYMENT_PENDING_MINUTES=15

# MVola (Telma / Yas) — https://developer.mvola.mg
#   sandbox : numéros de test 0343500003 (client) et 0343500004 (marchand)
MVOLA_ENV=sandbox
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_MSISDN=
MVOLA_PARTNER_NAME=Mekano

# Orange Money Web Payment — https://developer.orange.com (API « Orange Money Webpay »)
#   ORANGE_AUTH_HEADER = la valeur « Basic xxxx » de l'onglet Credentials, sans « Basic »
#   Callback à déclarer : PUBLIC_URL/api/payments/callback/orange
ORANGE_ENV=sandbox
ORANGE_AUTH_HEADER=
ORANGE_MERCHANT_KEY=
ORANGE_COUNTRY=mg

# Airtel Money — https://developers.airtel.africa (produit « Collection »)
#   Callback à déclarer dans le portail : PUBLIC_URL/api/payments/callback/airtel
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

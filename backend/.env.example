PORT=4000
DATABASE_URL=postgresql://mekano:mekano@localhost:5432/mekano
JWT_SECRET=change-me-in-production-mekano-secret
CORS_ORIGIN=*

# Validation admin : les liens Valider/Refuser sont envoyés à cet email
ADMIN_EMAIL=nantenainaraherimalala@gmail.com
# URL publique de l'API (utilisée dans les liens de validation des emails)
PUBLIC_URL=http://localhost:4000

# SMTP pour l'envoi des emails (ex. Gmail : smtp.gmail.com + mot de passe d'application)
# Si laissé vide, les liens de validation s'affichent dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
